# TaxShield Enterprise — environment template
# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- Security (required) ---
# 64 hex chars = 32 bytes, the AES-256-GCM key. Generate a fresh one:
#   python -c "import secrets; print(secrets.token_hex(32))"
TAXSHIELD_KEY=replace_with_64_hex_chars
# JWT signing secret for dashboard login. Generate similarly.
JWT_SECRET=replace_with_long_random_string
# Demo API user (change for anything non-local)
DEMO_USER=demo@taxshield.local
DEMO_PASSWORD=demo1234

# --- GitHub connector (optional; public repos work without a token) ---
# Create a fine-grained PAT with read-only Contents permission.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# --- Stripe connector (optional; test mode only) ---
# Dashboard -> Developers -> API keys -> Test secret key (sk_test_...)
STRIPE_TEST_KEY=

# --- LLM for the R&D classifier (optional; keyword fallback used if empty) ---
# Pick ONE provider. All have free tiers. "auto" tries in this order.
LLM_PROVIDER=auto            # auto | gemini | groq | openai | ollama | none
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=                   # optional override, e.g. gemini-2.0-flash, llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- App config ---
DASHBOARD_ORIGIN=http://localhost:3000
